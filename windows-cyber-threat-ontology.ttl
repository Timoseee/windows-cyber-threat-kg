@prefix : <https://github.com/Timoseee/windows-cyber-threat-kg/ontology#> .
@prefix cti: <https://github.com/Timoseee/windows-cyber-threat-kg/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://github.com/Timoseee/windows-cyber-threat-kg/ontology> .

<https://github.com/Timoseee/windows-cyber-threat-kg/ontology> rdf:type owl:Ontology ;
                                                                owl:imports <file:/C:/Users/lenovo/OneDrive/Desktop/windows-cyber-threat-instances.ttl> .

#################################################################
#    Object Properties
#################################################################

###  https://github.com/Timoseee/windows-cyber-threat-kg/ontology#affectsProduct
cti:affectsProduct rdf:type owl:ObjectProperty ;
                   rdfs:domain cti:Vulnerability ;
                   rdfs:range cti:SoftwareProduct .


###  https://github.com/Timoseee/windows-cyber-threat-kg/ontology#applicableToPlatform
cti:applicableToPlatform rdf:type owl:ObjectProperty ;
                         rdfs:domain cti:AttackTechnique ;
                         rdfs:range cti:Platform .


###  https://github.com/Timoseee/windows-cyber-threat-kg/ontology#belongsToPlatform
cti:belongsToPlatform rdf:type owl:ObjectProperty ;
                      rdfs:domain cti:OperatingSystem ;
                      rdfs:range cti:Platform .


###  https://github.com/Timoseee/windows-cyber-threat-kg/ontology#belongsToTactic
cti:belongsToTactic rdf:type owl:ObjectProperty ;
                    rdfs:domain cti:AttackTechnique ;
                    rdfs:range cti:AttackTactic .


###  https://github.com/Timoseee/windows-cyber-threat-kg/ontology#conductsCampaign
cti:conductsCampaign rdf:type owl:ObjectProperty ;
                     rdfs:domain cti:ThreatActor ;
                     rdfs:range cti:AttackCampaign .


###  https://github.com/Timoseee/windows-cyber-threat-kg/ontology#hasSeverity
cti:hasSeverity rdf:type owl:ObjectProperty ;
                rdfs:domain cti:Vulnerability ;
                rdfs:range cti:SeverityLevel .


###  https://github.com/Timoseee/windows-cyber-threat-kg/ontology#hasWeakness
cti:hasWeakness rdf:type owl:ObjectProperty ;
                rdfs:domain cti:Vulnerability ;
                rdfs:range cti:Weakness .


###  https://github.com/Timoseee/windows-cyber-threat-kg/ontology#usesTechnique
cti:usesTechnique rdf:type owl:ObjectProperty ;
                  rdfs:domain cti:ThreatActor ;
                  rdfs:range cti:AttackTechnique .


#################################################################
#    Classes
#################################################################

###  https://github.com/Timoseee/windows-cyber-threat-kg/ontology#AttackCampaign
cti:AttackCampaign rdf:type owl:Class .


###  https://github.com/Timoseee/windows-cyber-threat-kg/ontology#AttackTactic
cti:AttackTactic rdf:type owl:Class .


###  https://github.com/Timoseee/windows-cyber-threat-kg/ontology#AttackTechnique
cti:AttackTechnique rdf:type owl:Class .


###  https://github.com/Timoseee/windows-cyber-threat-kg/ontology#OperatingSystem
cti:OperatingSystem rdf:type owl:Class ;
                    rdfs:subClassOf cti:SoftwareProduct ;
                    rdfs:comment "This class is same with UCO's: OperatingSystem" ;
                    rdfs:seeAlso "https://ontology.unifiedcyberontology.org/uco/observable/OperatingSystem" .


###  https://github.com/Timoseee/windows-cyber-threat-kg/ontology#Platform
cti:Platform rdf:type owl:Class .


###  https://github.com/Timoseee/windows-cyber-threat-kg/ontology#SeverityLevel
cti:SeverityLevel rdf:type owl:Class .


###  https://github.com/Timoseee/windows-cyber-threat-kg/ontology#SoftwareProduct
cti:SoftwareProduct rdf:type owl:Class ;
                    rdfs:comment "This class is related to UCO: software" ;
                    rdfs:seeAlso "https://ontology.unifiedcyberontology.org/uco/observable/Software" .


###  https://github.com/Timoseee/windows-cyber-threat-kg/ontology#ThreatActor
cti:ThreatActor rdf:type owl:Class .


###  https://github.com/Timoseee/windows-cyber-threat-kg/ontology#Vulnerability
cti:Vulnerability rdf:type owl:Class ;
                  rdfs:subClassOf [ rdf:type owl:Restriction ;
                                    owl:onProperty cti:affectsProduct ;
                                    owl:someValuesFrom cti:SoftwareProduct
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cti:hasWeakness ;
                                    owl:someValuesFrom cti:Weakness
                                  ] .


###  https://github.com/Timoseee/windows-cyber-threat-kg/ontology#Weakness
cti:Weakness rdf:type owl:Class .


