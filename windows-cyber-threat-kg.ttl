cti:applicableToPlatform a owl:ObjectProperty ;
    rdfs:domain cti:AttackTechnique ;
    rdfs:range cti:Platform .

cti:belongsToPlatform a owl:ObjectProperty ;
    rdfs:domain cti:OperatingSystem ;
    rdfs:range cti:Platform .

cti:belongsToTactic a owl:ObjectProperty ;
    rdfs:domain cti:AttackTechnique ;
    rdfs:range cti:AttackTactic .

cti:conductsCampaign a owl:ObjectProperty ;
    rdfs:domain cti:ThreatActor ;
    rdfs:range cti:AttackCampaign .

cti:hasSeverity a owl:ObjectProperty ;
    rdfs:domain cti:Vulnerability ;
    rdfs:range cti:SeverityLevel .

cti:usesTechnique a owl:ObjectProperty ;
    rdfs:domain cti:ThreatActor ;
    rdfs:range cti:AttackTechnique .

cti:AttackCampaign a owl:Class .

