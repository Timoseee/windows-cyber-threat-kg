cti:Vulnerability a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cti:affectsProduct ;
            owl:someValuesFrom cti:SoftwareProduct ],
        [ a owl:Restriction ;
            owl:onProperty cti:hasWeakness ;
            owl:someValuesFrom cti:Weakness ] .

cti:Weakness a owl:Class .

cti:AttackTechnique a owl:Class .

cti:ThreatActor a owl:Class .

cti:OperatingSystem a owl:Class ;
    rdfs:comment "This class is same with UCO's: OperatingSystem" ;
    rdfs:seeAlso "https://ontology.unifiedcyberontology.org/uco/observable/OperatingSystem" ;
    rdfs:subClassOf cti:SoftwareProduct .

cti:Windows a owl:NamedIndividual,
        cti:Platform ;
    rdfs:label "Windows" .


