@prefix cti: <https://github.com/Timoseee/windows-cyber-threat-kg/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://github.com/Timoseee/windows-cyber-threat-kg/ontology> a owl:Ontology .

cti:APT29_G0016 a owl:NamedIndividual,
        cti:ThreatActor ;
    rdfs:label "APT29 (G0016)" ;
    rdfs:seeAlso "https://attack.mitre.org/groups/G0016/" ;
    cti:usesTechnique cti:T1566_001_SpearphishingAttachment .

cti:CVE_2024_30051 a owl:NamedIndividual,
        cti:Vulnerability ;
    rdfs:seeAlso "https://nvd.nist.gov/vuln/detail/CVE-2024-30051" ;
    cti:affectsProduct cti:Windows11_23H2 ;
    cti:hasWeakness cti:CWE_122_HeapBasedBufferOverflow .

cti:G0022 a cti:ThreatActor ;
    rdfs:label "APT3 (G0022)" ;
    cti:usesTechnique cti:T1053.005,
        cti:T1059.001,
        cti:T1059.003 .

cti:G0066 a cti:ThreatActor ;
    rdfs:label "Elderwood (G0066)" ;
    cti:usesTechnique cti:T1566_001_SpearphishingAttachment .

cti:G0082 a cti:ThreatActor ;
    rdfs:label "APT38 (G0082)" ;
    cti:usesTechnique cti:T1053.005,
        cti:T1059.001,
        cti:T1059.003,
        cti:T1566_001_SpearphishingAttachment .

cti:G0093 a cti:ThreatActor ;
    rdfs:label "GALLIUM (G0093)" ;
    cti:usesTechnique cti:T1047,
        cti:T1053.005,
        cti:T1059.001,
        cti:T1059.003 .

cti:G0094 a cti:ThreatActor ;
    rdfs:label "Kimsuky (G0094)" ;
    cti:usesTechnique cti:T1053.005,
        cti:T1059.001,
        cti:T1059.003,
        cti:T1566_001_SpearphishingAttachment .

cti:G0119 a cti:ThreatActor ;
    rdfs:label "Indrik Spider (G0119)" ;
    cti:usesTechnique cti:T1047,
        cti:T1059.001,
        cti:T1059.003 .

cti:G1008 a cti:ThreatActor ;
    rdfs:label "SideCopy (G1008)" ;
    cti:usesTechnique cti:T1566_001_SpearphishingAttachment .

cti:G1011 a cti:ThreatActor ;
    rdfs:label "EXOTIC LILY (G1011)" ;
    cti:usesTechnique cti:T1566_001_SpearphishingAttachment .

cti:G1037 a cti:ThreatActor ;
    rdfs:label "TA577 (G1037)" ;
    cti:usesTechnique cti:T1059.003 .

cti:G1043 a cti:ThreatActor ;
    rdfs:label "BlackByte (G1043)" ;
    cti:usesTechnique cti:T1047,
        cti:T1053.005,
        cti:T1059.001,
        cti:T1059.003 .

cti:applicableToPlatform a owl:ObjectProperty ;
    rdfs:domain cti:AttackTechnique ;
    rdfs:range cti:Platform .

cti:belongsToPlatform a owl:ObjectProperty ;
    rdfs:domain cti:OperatingSystem ;
    rdfs:range cti:Platform .

cti:belongsToTactic a owl:ObjectProperty ;
    rdfs:domain cti:AttackTechnique ;
    rdfs:range cti:AttackTactic .

cti:conductsCampaign a owl:ObjectProperty ;
    rdfs:domain cti:ThreatActor ;
    rdfs:range cti:AttackCampaign .

cti:hasSeverity a owl:ObjectProperty ;
    rdfs:domain cti:Vulnerability ;
    rdfs:range cti:SeverityLevel .

cti:usesTechnique a owl:ObjectProperty ;
    rdfs:domain cti:ThreatActor ;
    rdfs:range cti:AttackTechnique .

cti:AttackCampaign a owl:Class .

cti:CWE_122_HeapBasedBufferOverflow a owl:NamedIndividual,
        cti:Weakness ;
    rdfs:label "CWE-122: Heap-based Buffer Overflow" ;
    rdfs:seeAlso "https://cwe.mitre.org/data/definitions/122.html" .

cti:InitialAccess a owl:NamedIndividual,
        cti:AttackTactic ;
    rdfs:label "Initial Access" .

cti:SeverityLevel a owl:Class .

cti:Windows11_23H2 a owl:NamedIndividual,
        cti:OperatingSystem ;
    rdfs:label "Windows 11 Version 23H2" ;
    cti:belongsToPlatform cti:Windows .

cti:affectsProduct a owl:ObjectProperty ;
    rdfs:domain cti:Vulnerability ;
    rdfs:range cti:SoftwareProduct .

cti:hasWeakness a owl:ObjectProperty ;
    rdfs:domain cti:Vulnerability ;
    rdfs:range cti:Weakness .

cti:AttackTactic a owl:Class .

cti:OperatingSystem a owl:Class ;
    rdfs:comment "This class is same with UCO's: OperatingSystem" ;
    rdfs:seeAlso "https://ontology.unifiedcyberontology.org/uco/observable/OperatingSystem" ;
    rdfs:subClassOf cti:SoftwareProduct .

cti:Platform a owl:Class .

cti:SoftwareProduct a owl:Class ;
    rdfs:comment "This class is related to UCO: software" ;
    rdfs:seeAlso "https://ontology.unifiedcyberontology.org/uco/observable/Software" .

cti:T1047 a cti:AttackTechnique ;
    rdfs:label "Windows Management Instrumentation (T1047)" ;
    cti:applicableToPlatform cti:Windows .

cti:Weakness a owl:Class .

cti:Vulnerability a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cti:affectsProduct ;
            owl:someValuesFrom cti:SoftwareProduct ],
        [ a owl:Restriction ;
            owl:onProperty cti:hasWeakness ;
            owl:someValuesFrom cti:Weakness ] .

cti:T1053.005 a cti:AttackTechnique ;
    rdfs:label "Scheduled Task (T1053.005)" ;
    cti:applicableToPlatform cti:Windows .

cti:T1059.001 a cti:AttackTechnique ;
    rdfs:label "PowerShell (T1059.001)" ;
    cti:applicableToPlatform cti:Windows .

cti:T1566_001_SpearphishingAttachment a owl:NamedIndividual,
        cti:AttackTechnique ;
    rdfs:label "Spearphishing Attachment (T1566.001)" ;
    rdfs:seeAlso "https://attack.mitre.org/techniques/T1566/001/" ;
    cti:applicableToPlatform cti:Windows ;
    cti:belongsToTactic cti:InitialAccess .

cti:Windows a owl:NamedIndividual,
        cti:Platform ;
    rdfs:label "Windows" .

cti:T1059.003 a cti:AttackTechnique ;
    rdfs:label "Windows Command Shell (T1059.003)" ;
    cti:applicableToPlatform cti:Windows .

cti:AttackTechnique a owl:Class .

cti:ThreatActor a owl:Class .


